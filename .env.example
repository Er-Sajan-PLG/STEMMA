# STEMMA environment configuration (copy to .env, which is git-ignored).
# Keys are read by webapp/providers.py (line-based KEY=VALUE) and webapp/core.py.
# NEVER commit .env or real key values (CI secrets scan + gitleaks).

# Provider API keys for the webapp model selector / RAG (all optional; local
# deterministic fake embeddings work without any key):
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
OPENCODE_API_KEY=
# Used by scripts/embed.py frontier-model CLI runs (also passable via --api-key):
OPENAI_API_KEY=

# Override the HITL workflow directory (default: ./workflow):
# STEMMA_WORKFLOW_DIR=

# Webapp (admin tool) — extra hostnames allowed in the Host header, comma-separated,
# e.g. your Tailscale name. Loopback names are always allowed (ADR-0054):
# STEMMA_ALLOWED_HOSTS=
# Webapp — max request body in MB (uploads), default 50:
# STEMMA_MAX_BODY_MB=
