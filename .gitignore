__pycache__/
*.py[cod]
.venv/
venv/
# Proposal staging (ingestion output) — derived working area, never canonical.
proposals/

# Webapp workflow (uploads, extracted text, generated candidates, staged
# proposals, LLM provider config) — never canonical, never committed.
workflow/

# Explorer copy of the derived export (E7.4): synced by explorer/scripts/sync-export.mjs
# at dev/build time — the validator never writes into explorer/.
explorer/public/exports/
.env

# Derived embeddings are never committed or published (ADR-0054): they are
# regenerable, model-specific, and a consumer concern. embed.py refuses to write
# fake vectors unless --placeholder (pipeline tests only).
exports/embeddings.jsonl
exports/vector_store/

# Release staging (scripts/build_release_bundle.py). Releases live on GitHub
# Releases (.github/workflows/release.yml); bundles are not committed. The three
# legacy R6 bundles already tracked stay tracked.
release/R6-bundle-*/

# editable installs (pip install -e adapters/python)
*.egg-info/

# ── Key material safety net ──────────────────────────────────────────────────
# The owner's GPG private key and revocation certificate must NEVER be committed
# (docs/API.md "Owner signature"; docs/keys/README.md). The PUBLIC key at
# docs/keys/stemma-owner-pubkey.asc is intentionally tracked, so the negation
# below re-includes it after the broad *.asc rule.
*.asc
*.rev
!docs/keys/stemma-owner-pubkey.asc
