    {
      "id": "stemma:phys.mass",
      "type": "quantity",
      "name": "Mass",
      "domain": "physics",
      "subdomain": "measurement-units",
      "status": "canonical",
      "definition": "Mass is the SI base physical quantity measuring a body's inertia and its quantity of matter. Its SI unit, the kilogram, is defined by taking the fixed numerical value of the Planck constant h to be exactly 6.62607015e-34 when expressed in J s = kg m2 s-1, with the metre and second as separately defined (SI 2019 redefinition). Agreed per BIPM SI Brochure 9th ed. (2019) §2.3.1.",
      "symbol": "M",
      "unit": "kilogram (kg)",
      "same_dimensional_quantities": [
        "inertial mass",
        "gravitational mass",
        "rest mass"
      ],
      "quantity_kind": "base",
      "tensor_character": "scalar",
      "governed_by": [
        "stemma:phys.si-definitions",
        "stemma:phys.dimensional-analysis"
      ],
      "provenance": {
        "ai_drafted": true,
        "writer": "llm:coding-agent.001",
        "source_kind": "standards-or-specification",
        "source": "BIPM SI Brochure 9th ed. (2019): mass among the seven SI base quantities; kilogram defined by fixed h = 6.62607015e-34 kg m2 s-1 (2.3.1).",
        "link": "https://www.bipm.org/en/publications/si-brochure",
