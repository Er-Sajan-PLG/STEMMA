        "stemma:phys.dimensional-analysis"
      ],
      "provenance": {
        "ai_drafted": false,
        "writer": "human:curator.001",
        "source_kind": "standards-or-specification",
        "source": "BIPM SI Brochure 9th ed. (2019) §2.3.1, p130-132: The metre, symbol m, is the SI unit of length. It is defined by taking the fixed numerical value of the speed of light in vacuum c to be 299792458 when expressed in m s-1. Exact: c=299,792,458 m/s. Agreed internationally.",
        "link": "https://www.bipm.org/en/publications/si-brochure",
        "original_author": "BIPM",
        "retrieved_at": "2026-09-21",
        "reviewer": "human:curator.001",
        "reviewed_at": "2026-09-23T04:35:19.817235+00:00"
