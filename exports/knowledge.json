  "entities": [
    {
      "id": "stemma:phys.conservation-energy",
      "type": "law",
      "name": "Conservation of Energy",
      "domain": "physics",
      "subdomain": "mechanics",
      "status": "canonical",
      "definition": "Conservation of energy: for an isolated system the total energy — summed over all forms (kinetic, potential, thermal, chemical, nuclear, ...) — remains constant in time; energy transforms between forms but is neither created nor destroyed. Historical line: Mayer (1842), Joule (1843), Helmholtz (1847, 'Über die Erhaltung der Kraft'); standard statement per Halliday, Resnick, Walker 12th ed., Ch 8.",
      "symbol": "E_total = const",
      "same_dimensional_quantities": null,
      "governed_by": [
        "stemma:phys.newtons-second-law",
        "stemma:phys.dimensional-analysis"
      ],
      "provenance": {
        "ai_drafted": true,
        "writer": "llm:coding-agent.001",
        "source_kind": "textbook",
        "source": "Halliday, Resnick, Walker, Fundamentals of Physics 12th ed., Ch 8 (potential energy and conservation of energy in isolated systems).",
        "link": "https://www.wiley.com/en-us/Fundamentals+of+Physics%2C+12th+Edition-p-9781119773511",
        "original_author": "Mayer, Joule, Helmholtz",
        "retrieved_at": "2026-09-22",
        "reviewer": "human:curator.001",
        "reviewed_at": "2026-09-23T04:35:20.283368+00:00"
      },
      "source_refs": [
        "stemma:src.halliday-resnick-walker-12th"
      ],
      "external_ids": {
        "wd": "Q11382"
      },
      "historical": {
        "stated_by": "Julius Robert Mayer / Hermann von Helmholtz",
        "year": 1847,
        "where": "Helmholtz, Über die Erhaltung der Kraft",
        "timeline": [
          {
            "year": 1842,
            "by": "Julius Robert Mayer",
            "event": "First statement of energy conservation (work-heat equivalence)"
