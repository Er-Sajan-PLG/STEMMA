        "sourceCitation": "Halliday, Resnick, Walker, Fundamentals of Physics 12th ed., Ch 5: net force ΣF = m a; Principia (1687), Lex II: mutationem motus proportionalem esse vi motrici impressae."
      }
    },
    {
      "@id": "stemma:phys.length",
      "@type": [
        "skos:Concept",
        "qudt:Quantity",
        "stemma:Quantity"
      ],
      "name": "Length",
      "type": "quantity",
      "status": "canonical",
      "definition": "Length is the SI base physical quantity of spatial extent — the measure of one-dimensional distance between two points in space. The metre is the unit in which length is expressed: 1 m = the length of the path travelled by light in vacuum during 1/299,792,458 of a second (c fixed exact). Agreed per BIPM SI Brochure 9th ed. (2019), base quantities table; §2.3.1.",
      "sameDimensionalQuantities": [
        "width",
        "height",
        "displacement magnitude",
        "wavelength",
        "radius",
        "thickness"
      ],
      "quantityKind": "base",
      "tensorCharacter": "scalar",
      "symbol": "L",
      "unit": "metre (m)",
      "governedBy": [
        "stemma:phys.dimensional-analysis",
        "stemma:phys.si-definitions"
      ],
