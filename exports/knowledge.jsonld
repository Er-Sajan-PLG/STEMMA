        "writer": "llm:coding-agent.001",
        "reviewer": "human:curator.001",
        "reviewedAt": "2026-09-23T04:35:19.964859+00:00",
        "sourceKind": "standards-or-specification",
        "sourceCitation": "BIPM SI Brochure 9th ed. (2019): among the seven SI base quantities, length with base unit metre; metre defined by fixed numerical value of c in vacuum (2.3.1)."
      }
    },
    {
      "@id": "stemma:phys.mass",
      "@type": [
        "skos:Concept",
        "qudt:Quantity",
        "stemma:Quantity"
      ],
      "name": "Mass",
      "type": "quantity",
      "status": "canonical",
      "definition": "Mass is the SI base physical quantity measuring a body's inertia and its quantity of matter. Its SI unit, the kilogram, is defined by taking the fixed numerical value of the Planck constant h to be exactly 6.62607015e-34 when expressed in J s = kg m2 s-1, with the metre and second as separately defined (SI 2019 redefinition). Agreed per BIPM SI Brochure 9th ed. (2019) §2.3.1.",
      "sameDimensionalQuantities": [
        "inertial mass",
        "gravitational mass",
        "rest mass"
      ],
      "quantityKind": "base",
      "tensorCharacter": "scalar",
      "symbol": "M",
      "unit": "kilogram (kg)",
      "governedBy": [
        "stemma:phys.dimensional-analysis",
        "stemma:phys.si-definitions"
      ],
