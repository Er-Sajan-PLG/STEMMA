{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stemma.example/schema/connection.schema.json",
  "title": "STEMMA connection (first-class assertion) — Architecture v2",
  "description": "Schema for one canonical connection — first-class qualified assertion with value-slot XOR target/value, warrant axis definitional axiomatic model_based, correction labels, delegated authority v2 audited federation. See ADR-0044, ADR-0045, ADR-0046, ADR-0047, ADR-0048, ADR-0049. Architecture v2 ideal order.",
  "type": "object",
  "required": ["id", "type", "source", "relation", "assertion", "provenance"],
  "allOf": [
    {
      "oneOf": [
        {"required": ["target"], "not": {"required": ["value"]}},
        {"required": ["value"], "not": {"required": ["target"]}}
      ],
      "description": "Value-slot XOR target/value per ADR-0045 — either relational (target) or valued (value) claim, not both, not neither"
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^stemma:conn\\.[0-9]{6}$",
      "description": "Sequential opaque connection ID (stemma:conn.000001), immutable, never reused per L5."
    },
    "type": { "const": "connection" },
    "source": {
      "type": "string",
      "pattern": "^stemma:[a-z][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$",
      "description": "Source entity ID."
    },
    "relation": {
      "type": "string",
      "description": "Relation name; validated against relation-registry.yaml authoritative per ADR-0048 includes equivalent_to misconception_of."
    },
    "target": {
      "type": "string",
      "pattern": "^stemma:[a-z][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$",
      "description": "Target entity ID — absent when value present XOR per ADR-0045."
    },
    "value": {
      "type": "object",
      "description": "Value-slot per ADR-0045 — structured value for measurements, prevalence, typed literals — Wikibase QuantityValue aligned asymmetric bounds explicit unit IRIs dimensionless sentinel 1 interim allowlist QUDT/UCUM/SI symbols",
      "required": ["amount"],
      "properties": {
        "amount": {
          "type": "string",
          "description": "Decimal string Wikibase-aligned e.g., 42.0"
        },
        "lowerBound": {
          "type": ["string", "null"],
          "description": "Optional lower bound asymmetric"
        },
        "upperBound": {
          "type": ["string", "null"],
          "description": "Optional upper bound asymmetric"
        },
        "unit": {
          "type": "string",
          "description": "Unit IRI per ADR-0024 or 1 dimensionless interim allowlist QUDT/UCUM/SI symbols m kg s A K mol cd documented as interim"
        }
      },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": ["status", "type", "review"],
      "properties": {
        "status": { "enum": ["active", "deprecated", "superseded"] },
        "type": { "enum": ["asserted", "inferred", "proposed"], "description": "Surgical per ADR-0046 — do NOT expand to derived disputed hypothesized warrant belongs on confidence_basis" },
        "polarity": { "enum": ["positive", "negative"], "default": "positive", "description": "M2: affirmed vs negated claim (default positive). Rejected != negated." },
        "review": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "enum": ["unreviewed", "reviewed", "canonical", "rejected"] },
            "authority": { "enum": ["internal", "delegated"], "description": "Per ADR-0049 delegated authority v2 — internal STEMMA-reviewed vs delegated institution-verified" }
          },
          "additionalProperties": false
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Belief that this assertion is correct within its context. Null if unknown."
        },
        "confidence_basis": {
          "type": ["string", "null"],
          "enum": ["expert_review", "experimental", "theoretical", "derived", "definitional", "axiomatic", "model_based", null],
          "description": "Warrant axis per ADR-0046 — how justified, extended with definitional axiomatic model_based, pairs with confidence"
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "anyOf": [
        {"type": "object", "properties": {"reason": { "type": ["string", "null"] }, "replaced_by": { "type": ["string", "null"], "pattern": "^stemma:conn\\.[0-9]{6}$" }}, "additionalProperties": false},
        {"type": "null"}
      ]
    },
    "created_at": { "type": ["string", "null"], "description": "ISO8601 creation time (M3 repository lifecycle) — not in canonical export only workflow audit per L5 content_hash" },
    "updated_at": { "type": ["string", "null"], "description": "ISO8601 last modification time — not in canonical export only workflow audit" },
    "validity": {
      "anyOf": [
        {"type": "object", "properties": {"valid_from": { "type": ["string", "null"] }, "valid_until": { "type": ["string", "null"] }}, "additionalProperties": false},
        {"type": "null"}
      ]
    },
    "context": {
      "type": "object",
      "properties": {
        "domain": { "type": "string" },
        "subdomain": { "type": "string" },
        "regime": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Controlled multi-valued regimes (see vocabularies/regimes.yaml)."
        },
        "scale": { "type": "string" },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "value"],
            "properties": {
              "type": { "type": "string" },
              "value": { "type": "string" },
              "unit": { "type": "string" }
            },
            "additionalProperties": false
          },
          "description": "M12: extensible qualifiers (conditions, scope, system, boundary, temperature, pressure, etc.) per ADR-0044"
        }
      },
      "additionalProperties": true
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Legacy scalar assumptions; prefer context.assumptions."
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "enum": ["definition", "axiom", "mathematical_derivation", "empirical_measurement", "experiment", "observation", "simulation", "review", "textbook", "standard", "dataset", "expert_assessment", "derivation", "other"] },
          "stance": { "enum": ["supports", "weakly_supports", "contradicts", "qualifies"], "description": "M9: evidence direction, default supports" },
          "source_ref": { "type": "string", "pattern": "^stemma:src\\." },
          "locator": { "type": "string" },
          "locator_struct": {
            "anyOf": [
              {"type": "object", "properties": {"page": { "type": ["string", "null"] }, "section": { "type": ["string", "null"] }, "equation": { "type": ["string", "null"] }, "figure": { "type": ["string", "null"] }, "table": { "type": ["string", "null"] }, "dataset": { "type": ["string", "null"] }, "code": { "type": ["string", "null"] }}, "additionalProperties": false},
              {"type": "null"}
            ]
          },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      },
      "description": "Required for canonical per L1 claim sole bearer truth must carry evidence per ADR-0044 gate enforces validate.py:658"
    },
    "provenance": {
      "type": "object",
      "required": ["asserted_by", "generated_by", "method"],
      "properties": {
        "asserted_by": {
          "type": "object",
          "required": ["type", "id"],
          "properties": {
            "type": { "enum": ["human", "llm", "process", "unknown"] },
            "id": { "type": "string" }
          },
          "additionalProperties": false
        },
        "generated_by": {
          "type": "object",
          "required": ["type", "id"],
          "properties": {
            "type": { "enum": ["process", "human", "llm"] },
            "id": { "type": "string" }
          },
          "additionalProperties": false
        },
        "reviewed_by": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "id"],
            "properties": {
              "type": { "enum": ["human", "llm"] },
              "id": { "type": "string" },
              "authority": { "enum": ["internal", "delegated"], "description": "Per ADR-0049 delegated authority v2 internal vs delegated" },
              "delegated_provenance": {
                "type": ["object", "null"],
                "properties": {
                  "institution_id": { "type": "string" },
                  "review_standard_url": { "type": "string" },
                  "review_standard_version": { "type": "string" },
                  "audit_date": { "type": "string" },
                  "sample_audit_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
                },
                "additionalProperties": false,
                "description": "Per ADR-0049 delegated authority v2 audited federation"
              }
            },
            "additionalProperties": false
          }
        },
        "method": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "enum": ["manual", "llm_inference", "rule_inference", "migration"] },
            "model": { "type": "string" },
            "prompt_version": { "type": "string" }
          },
          "additionalProperties": false
        },
        "review_history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "reviewer", "at"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "reviewer": { "type": "string" },
              "at": { "type": "string" },
              "reason": { "type": "string" },
              "authority": { "enum": ["internal", "delegated"], "description": "Per ADR-0049 delegated authority v2" },
              "correction_class": {
                "type": ["string", "null"],
                "enum": ["factual_error", "category_error", "relationship_error", "provenance_error", "incompleteness", "hallucination", "format_error", "dangling_ref", null],
                "description": "Per ADR-0046 correction labels why corrected attaches to review decisions not whole claims per L3"
              },
              "delegated_provenance": {
                "type": ["object", "null"],
                "properties": {
                  "institution_id": { "type": "string" },
                  "review_standard_url": { "type": "string" },
                  "review_standard_version": { "type": "string" },
                  "audit_date": { "type": "string" },
                  "sample_audit_rate": { "type": "number" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "inference": {
      "type": "object",
      "properties": {
        "rule": { "type": "string" },
        "path": {
          "type": "array",
          "items": { "type": "string", "pattern": "^stemma:" }
        }
      },
      "additionalProperties": false
    },
    "rights": {
      "anyOf": [
        {"type": "object", "properties": {"license": { "type": "string" }, "attribution": { "type": "string" }, "rights_holder": { "type": "string" }}, "additionalProperties": false},
        {"type": "null"}
      ]
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "description": "Adaptive metadata seam (ADR-0017). Open at schema level; validator enforces registry membership per connection."
    }
  },
  "additionalProperties": false
}
