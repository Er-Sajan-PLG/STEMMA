{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stemma.example/schema/connection.schema.json",
  "title": "STEMMA connection (first-class assertion)",
  "description": "Schema for one canonical connection — first-class qualified assertion (v0.2). See ADR-011.",
  "type": "object",
  "required": ["id", "type", "source", "relation", "target", "assertion", "provenance"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^stemma:conn\\.[a-z0-9\\-]+$",
      "description": "Connection ID (stemma:conn.NNNNNN or stemma:conn.slug), immutable, never reused."
    },
    "type": { "const": "connection" },
    "source": {
      "type": "string",
      "pattern": "^(stemma|lhs):[a-z][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$",
      "description": "Source entity ID."
    },
    "relation": {
      "type": "string",
      "description": "Relation name; validated against relation-registry.yaml (authoritative)."
    },
    "target": {
      "type": "string",
      "pattern": "^(stemma|lhs):[a-z][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$",
      "description": "Target entity ID."
    },
    "assertion": {
      "type": "object",
      "required": ["status", "type", "review"],
      "properties": {
        "status": { "enum": ["active", "deprecated", "superseded"] },
        "type": { "enum": ["asserted", "inferred", "proposed"] },
        "polarity": { "enum": ["positive", "negative"], "default": "positive", "description": "M2: affirmed vs negated claim." },
        "review": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "enum": ["unreviewed", "reviewed", "canonical", "rejected"] }
          },
          "additionalProperties": false
        },
        "confidence": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
        "confidence_basis": { "type": ["string", "null"], "enum": ["expert_review", "experimental", "theoretical", "derived", null] }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "domain": { "type": "string" },
        "subdomain": { "type": "string" },
        "regime": { "type": "array", "items": { "type": "string" } },
        "scale": { "type": "string" },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "qualifiers": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "enum": ["definition", "axiom", "mathematical_derivation", "empirical_measurement", "experiment", "observation", "simulation", "review", "textbook", "standard", "dataset", "expert_assessment", "derivation", "other"] },
          "stance": { "enum": ["supports", "weakly_supports", "contradicts", "qualifies"] },
          "source_ref": { "type": "string", "pattern": "^stemma:src\\.[a-z0-9][a-z0-9-]*$" },
          "locator": { "type": ["string", "object"] },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": ["asserted_by", "generated_by", "method"],
      "properties": {
        "asserted_by": {
          "type": "object",
          "required": ["type", "id"],
          "properties": {
            "type": { "enum": ["human", "llm", "process", "unknown"] },
            "id": { "type": "string" }
          },
          "additionalProperties": false
        },
        "generated_by": {
          "type": "object",
          "required": ["type", "id"],
          "properties": {
            "type": { "enum": ["process", "human", "llm"] },
            "id": { "type": "string" }
          },
          "additionalProperties": false
        },
        "reviewed_by": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "id"],
            "properties": {
              "type": { "enum": ["human", "llm"] },
              "id": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "method": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "enum": ["manual", "llm_inference", "rule_inference", "migration"] },
            "model": { "type": "string" },
            "prompt_version": { "type": "string" }
          },
          "additionalProperties": false
        },
        "review_history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "reviewer", "at"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "reviewer": { "type": "string" },
              "at": { "type": "string" },
              "reason": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "anyOf": [
        {"type": "object", "properties": {"reason": { "type": ["string", "null"] }, "replaced_by": { "type": ["string", "null"] }}},
        {"type": "null"}
      ]
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "description": "Adaptive metadata seam (ADR-0017)."
    }
  },
  "additionalProperties": false
}
