{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stemma.example/schema/export.schema.json",
  "title": "STEMMA export contract v2.2 (exports/knowledge.json) — Architecture v2",
  "description": "Consumer contract for the derived export. v2.0 (ADR-0028): the generated inline entities[].relationships projection is REMOVED — the relationship graph is connections[] only. IDs are stemma:-namespaced (ADR-0027). v2.1 (ADR-0032): additive optional relation_registry + vocabularies sidecar. v2.2 (ADR-0050): additive value-slot XOR target/value per ADR-0045 + authority field internal|delegated per ADR-0049 delegated authority v2 + warrant axis definitional axiomatic model_based per ADR-0046 + correction_class per ADR-0046. Enforced by scripts/validate.py before the export is written.",
  "type": "object",
  "required": [
    "export_version",
    "schema_version",
    "content_hash",
    "source",
    "entity_count",
    "connection_count",
    "source_count",
    "entities",
    "connections",
    "sources"
  ],
  "properties": {
    "export_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the export contract (semver). v2.0.0: stemma: namespace, connections[] is the only relationship source, entities[].relationships removed (ADR-0027/0028)."
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the canonical schemas."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "kernel_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "relation_registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semver of schema/relation-registry.yaml (ADR-0032, export v2.1.0). Optional; old readers ignore it."
    },
    "relation_registry": {
      "type": "object",
      "description": "Relation name -> {family, inverse, transitive, symmetric, domain, range, status}. Optional sidecar (ADR-0032). Consumers MUST fail closed on an unknown relation when this member is present."
    },
    "vocabularies": {
      "type": "object",
      "description": "Controlled domains/subdomains/regimes/scales mirroring schema/vocabularies/. Optional sidecar (ADR-0032).",
      "properties": {
        "domains": {
          "type": "array",
          "items": { "type": "string" }
        },
        "subdomains": {
          "type": "object"
        },
        "regimes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scales": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "string"
    },
    "entity_count": {
      "type": "integer",
      "minimum": 0
    },
    "connection_count": {
      "type": "integer",
      "minimum": 0
    },
    "source_count": {
      "type": "integer",
      "minimum": 0
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "name",
          "domain",
          "status",
          "definition",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^stemma:"
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "source",
          "relation",
          "assertion",
          "provenance"
        ],
        "allOf": [
          {
            "oneOf": [
              {"required": ["target"], "not": {"required": ["value"]}},
              {"required": ["value"], "not": {"required": ["target"]}}
            ],
            "description": "Value-slot XOR target/value per ADR-0045 — either relational (target) or valued (value) claim"
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^stemma:conn\\.[0-9]{6}$"
          },
          "target": {
            "type": "string",
            "pattern": "^stemma:[a-z][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$",
            "description": "Target entity ID — absent when value present XOR per ADR-0045"
          },
          "value": {
            "type": "object",
            "description": "Value-slot per ADR-0045 — structured value amount + bounds + unit",
            "required": ["amount"],
            "properties": {
              "amount": {"type": "string"},
              "lowerBound": {"type": ["string", "null"]},
              "upperBound": {"type": ["string", "null"]},
              "unit": {"type": "string"}
            },
            "additionalProperties": false
          },
          "claim_signature": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "DERIVED identity of the asserted proposition: sha256(source|relation|target|value_canonical|polarity|sorted qualifiers) per ADR-0045 — covers value-slot. Two active connections sharing a signature are duplicate-claim gate failure. Never stored in canonical YAML."
          },
          "assertion": {
            "type": "object",
            "required": [
              "status",
              "type",
              "review"
            ],
            "properties": {
              "review": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {"type": "string"},
                  "authority": {"type": "string", "enum": ["internal", "delegated"], "description": "Per ADR-0049 delegated authority v2"}
                },
                "additionalProperties": true
              },
              "confidence_basis": {
                "type": ["string", "null"],
                "enum": ["expert_review", "experimental", "theoretical", "derived", "definitional", "axiomatic", "model_based", null],
                "description": "Warrant axis per ADR-0046"
              }
            },
            "additionalProperties": true
          },
          "provenance": {
            "type": "object",
            "properties": {
              "reviewed_by": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "authority": {"type": "string", "enum": ["internal", "delegated"]},
                    "delegated_provenance": {"type": ["object", "null"]}
                  },
                  "additionalProperties": true
                }
              },
              "review_history": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "authority": {"type": "string", "enum": ["internal", "delegated"]},
                    "correction_class": {"type": ["string", "null"], "enum": ["factual_error", "category_error", "relationship_error", "provenance_error", "incompleteness", "hallucination", "format_error", "dangling_ref", null]},
                    "delegated_provenance": {"type": ["object", "null"]}
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "citation"
        ]
      }
    }
  },
  "additionalProperties": false
}
